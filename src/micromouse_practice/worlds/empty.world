<?xml version="1.0"?>
<sdf version="1.6"><world name="practice_empty">
  <include><uri>model://sun</uri></include><include><uri>model://ground_plane</uri></include>
  <physics name="ode" type="ode"><max_step_size>0.001</max_step_size><real_time_update_rate>2000</real_time_update_rate></physics>
  <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so"><update_rate>20</update_rate></plugin>
  <gui><camera name="user_camera"><pose>0.5 -4 7 0 1.0 1.57</pose></camera></gui>
</world></sdf>
