Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 38; 46
    Fixed Frame: map
    Frame Rate: 15
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Wall occupancy grid
      Enabled: true
      Topic:
        Value: /map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Alpha: 0.6
    - Class: rviz_default_plugins/Map
      Name: Inflated planning grid
      Enabled: false
      Topic:
        Value: /planning_grid
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Alpha: 0.3
    - Class: rviz_default_plugins/Grid
      Name: Grid (0.25m)
      Enabled: true
      Cell Size: 0.25
      Plane Cell Count: 40
      Color: 105; 110; 120
    - Class: rviz_default_plugins/RobotModel
      Name: TurtleBot3
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/LaserScan
      Name: Laser scan
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Size (m): 0.025
      Color: 255; 70; 80
      Color Transformer: FlatColor
      Style: Points
    - Class: rviz_default_plugins/Path
      Name: Reference (orange)
      Enabled: true
      Topic:
        Value: /reference_path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Color: 255; 170; 40
      Line Style: Billboards
      Line Width: 0.004
      Buffer Length: 1
    - Class: rviz_default_plugins/Path
      Name: Driven trail (cyan)
      Enabled: true
      Topic:
        Value: /trajectory
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Color: 0; 230; 255
      Line Style: Billboards
      Line Width: 0.008
      Buffer Length: 1
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top view
      Target Frame: odom
      Scale: 65
      X: 0.0
      Y: 0.0
      Angle: 0
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
Window Geometry:
  Width: 1100
  Height: 760
